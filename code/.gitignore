.kilo/worktrees

# Local secrets must never be committed (FR-30). The device gets credentials via the
# captive portal / BLE provisioning into NVS; anything here is for local dev only.
.env
.env.*
secrets.json
scratch.txt

# Generated by tools/gen_secrets_header.py for the bench verification build only.
# Listed by exact path AND by pattern so a rename cannot quietly start tracking it.
firmware/src/secrets_build.h
secrets_build.h
secrets_*.h
